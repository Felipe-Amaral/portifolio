---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { artigos, formatarData, minutosDeLeitura } from '../../lib/colecoes';
import { site } from '../../data/site';
import PodcastPlayer from '../../components/PodcastPlayer.astro';

export async function getStaticPaths() {
  const lista = await artigos();
  return lista.map((artigo, i) => ({
    params: { id: artigo.id },
    props: { artigo, anterior: lista[i + 1], proximo: lista[i - 1] },
  }));
}

const { artigo, anterior, proximo } = Astro.props;
const { Content, headings } = await render(artigo);
const a = artigo.data;
const secoes = headings.filter((h) => h.depth === 2);
---

<Base title={a.titulo} description={a.descricao} type="article">
  <i class="progress" aria-hidden="true"></i>

  <section class="stack">
    <div class="stack-sm">
      <span class="kicker a-wipe d2">{a.tipo}</span>
      <span class="meta">
        <time datetime={a.data.toISOString()}>{formatarData(a.data)}</time> // {minutosDeLeitura(artigo.body)} MIN DE LEITURA
      </span>
    </div>
    <h1 class="title title--long a-glitch d4"><span>{a.titulo}</span></h1>
    <p class="lead muted a-flicker d8">{a.descricao}</p>
    {a.podcast && (
      <PodcastPlayer src={a.podcast.arquivo} titulo={a.titulo} tamanho={a.podcast.tamanho} duracao={a.podcast.duracao} />
    )}
    {a.tags.length > 0 && (
      <ul class="row" aria-label="Tags">
        {a.tags.map((t) => <li class="pill">{t.toUpperCase()}</li>)}
      </ul>
    )}
  </section>

  <div class="split">
    <article class="split__main prose">
      {a.video && (
        <div class="embed">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${a.video}`}
            title={`Vídeo: ${a.titulo}`}
            loading="lazy"
            allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      )}
      <Content />
      <nav class="row row--between" aria-label="Outros artigos">
        {anterior ? <a class="more" href={`/artigos/${anterior.id}/`}>◂ ARTIGO ANTERIOR</a> : <span></span>}
        {proximo && <a class="more" href={`/artigos/${proximo.id}/`}>PRÓXIMO ARTIGO ▸</a>}
      </nav>
    </article>

    <aside class="split__side">
      {secoes.length > 0 && (
        <nav class="toc" aria-label="Neste artigo">
          <span class="small cyan">$ ls ./artigo</span>
          {secoes.map((h, i) => (
            <a href={`#${h.slug}`}>{String(i + 1).padStart(2, '0')} // {h.text}</a>
          ))}
        </nav>
      )}
      <div class="edu">
        <strong>{site.nome.toUpperCase()}</strong>
        <span class="small muted">Arquiteto de software. Escrevo sobre as decisões que tomo no trabalho, com os erros incluídos.</span>
        <a class="more" href="/curriculo/">VER CURRÍCULO ▸</a>
      </div>
    </aside>
  </div>
</Base>

<script>
  import '../../scripts/toc';
</script>
